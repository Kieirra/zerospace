---
import GameImage from '../../../wiki/game-image/game-image.astro';
import { entityHref } from '../../../wiki/wiki.helpers.ts';
import type { Entity } from '../../../wiki/wiki.types.ts';
import EntityPill from '../../entity-pill/entity-pill.astro';
import { toPreviewId, toPreviewSummaryId } from '../../entity-previews/entity-previews.helpers.ts';

interface Props {
  hero?: Entity;
  talents: Entity[];
}

const { hero, talents } = Astro.props;
---

<div class="flex flex-col gap-6 bevel-sm bg-surface p-4">
  {
    hero && (
      <section>
        <h2 class="mb-3 text-xs text-muted label-caps">Starting hero</h2>
        <EntityPill entity={hero} />
      </section>
    )
  }
  {
    talents.length > 0 && (
      <section>
        <h2 class="mb-3 text-xs text-muted label-caps">Talents</h2>
        <ul class="flex flex-wrap items-center gap-2">
          {talents.map((talent) => (
            <li>
              <a
                href={entityHref(talent.id)}
                target="_blank"
                rel="noopener"
                aria-label={talent.name}
                aria-describedby={toPreviewSummaryId(talent.id)}
                data-entity-preview={toPreviewId(talent.id)}
              >
                <GameImage id={talent.id} name={talent.name} size="mini" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
