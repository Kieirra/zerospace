---
import clock from 'lucide-static/icons/clock.svg?raw';
import CostValue from '../../../../../wiki/cost-value/cost-value.astro';
import type { BuildOrderChipWhen } from '../../../../guides.types.ts';

interface Props {
  when: BuildOrderChipWhen;
}

const { when } = Astro.props;
// Mobile: the font resets undo the label caps of the line above the pills.
// Desktop: sm:-my-1.5 pulls the chip up to the top of the cell, level with the pills of the BUILD column.
---

<span
  role="img"
  aria-label={when.label}
  class="inline-flex h-8 items-center gap-1.5 bevel-sm bg-surface-raised px-2.5 align-top font-sans text-sm font-normal tracking-normal tabular-nums sm:-my-1.5"
>
  {
    when.type === 'resources' ? (
      when.resources.map((resource, index) => (
        <>
          {index > 0 && <span class="text-muted">·</span>}
          <CostValue value={[resource]} />
        </>
      ))
    ) : (
      <>
        <span class="inline-flex text-muted [&>svg]:size-3.5" set:html={clock} />
        {when.time}
      </>
    )
  }
</span>
