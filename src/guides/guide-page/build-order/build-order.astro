---
import DensePanel from '../../../wiki/dense-panel/dense-panel.astro';
import type { ResolvedBuildOrder } from '../../guides.types.ts';
import BuildOrderPhases from './build-order-phases/build-order-phases.astro';

interface Props {
  title: string;
  factionId?: string;
  buildOrder: ResolvedBuildOrder;
}

const { title, factionId, buildOrder } = Astro.props;
---

<DensePanel factionId={factionId}>
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-xs text-muted label-caps">Build order</h2>
    <button
      type="button"
      data-copy-build-order
      data-source={`## ${title}\n\n${buildOrder.source}`}
      class="bevel-sm bg-surface-raised px-3 py-1 text-xs transition-colors hover:bg-surface-hover"
    >
      Copy
    </button>
  </div>
  <BuildOrderPhases steps={buildOrder.steps} notes={buildOrder.notes} />
</DensePanel>

<script>
  const COPIED_MS = 1500;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-build-order]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.source ?? '');
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy'), COPIED_MS);
    });
  }
</script>
