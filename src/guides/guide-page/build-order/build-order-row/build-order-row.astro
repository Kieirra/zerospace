---
import type { BuildOrderRow } from '../../../guides.types.ts';
import BuildOrderWhen from '../build-order-when/build-order-when.astro';

interface Props {
  row: BuildOrderRow;
}

const { row } = Astro.props;
---

<tr class="border-t border-line align-top">
  <td class="w-10 py-2.5 pr-2 leading-8 font-bold tabular-nums">{row.number}</td>
  <td class="hidden w-44 pt-4 pr-4 pb-2.5 text-sm sm:table-cell">
    {row.when && <BuildOrderWhen when={row.when} />}
  </td>
  <td class="py-2.5">
    {
      row.when && (
        <p class="mb-1.5 text-xs label-caps sm:hidden">
          <BuildOrderWhen when={row.when} />
        </p>
      )
    }
    <div class="flex flex-wrap items-center gap-2">
      <slot />
    </div>
  </td>
</tr>
