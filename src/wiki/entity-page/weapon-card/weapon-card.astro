---
import clsx from 'clsx';
import StatTiles from '../stat-tiles/stat-tiles.astro';
import { isHealWeapon, toWeaponTiles } from '../entity-weapons/entity-weapons.helpers.ts';
import type { Weapon } from '../../wiki.types.ts';

interface Props {
  weapon: Weapon;
  isEmbedded?: boolean;
}

const { weapon, isEmbedded } = Astro.props;
---

<div class={clsx(!isEmbedded && 'h-full bevel-sm bg-surface p-3')}>
  <h3 class="mb-2 flex flex-wrap items-center gap-2 font-semibold">
    {weapon.name}
    {isHealWeapon(weapon) && <span class="bg-heal/15 px-1.5 text-xs font-semibold text-heal">Heal</span>}
    {weapon.melee && <span class="bg-surface-raised px-1.5 text-xs font-normal text-muted">Melee</span>}
  </h3>
  <StatTiles tiles={toWeaponTiles(weapon)} isNested />
</div>
