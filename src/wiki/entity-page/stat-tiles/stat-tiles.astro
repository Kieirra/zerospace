---
import clsx from 'clsx';
import CostValue from '../../cost-value/cost-value.astro';
import StatIcon from '../stat-icon/stat-icon.astro';
import { findImageUrl } from '../../game-image/game-image.helpers.ts';
import { toLabelResource } from '../../wiki.helpers.ts';
import type { StatTile } from '../../wiki.types.ts';
import { toBatchPrefix, toShortLabel, toTileMinWidth } from './stat-tiles.helpers.ts';

interface Props {
  tiles: StatTile[];
  isNested?: boolean;
}

const { tiles, isNested } = Astro.props;
const resourceIconUrls = tiles.map(({ label }) => {
  const resource = toLabelResource(label);
  return resource && findImageUrl(`icons/${resource}`);
});
---

{
  tiles.length > 0 && (
    <dl
      class="grid grid-cols-[repeat(auto-fill,minmax(min(var(--tile-min),100%),1fr))] gap-1.5 tabular-nums"
      style={`--tile-min: ${toTileMinWidth(
        tiles.map(({ label }) => label),
        isNested,
      )}`}
    >
      {tiles.map(({ label, value, batch, isAccent, isHeal, levels, span }, tileIndex) => (
        <div
          class={clsx('min-w-0 bevel-sm px-2.5 py-1.5', isNested ? 'bg-surface-raised' : 'bg-surface', span === 2 && 'sm:col-span-2')}
        >
          <dt class="flex items-center gap-1 font-label text-[10px] font-semibold tracking-[.12em] text-muted uppercase">
            {resourceIconUrls[tileIndex] ? (
              <img
                src={resourceIconUrls[tileIndex]}
                alt=""
                width="12"
                height="12"
                decoding="async"
                class="size-3 max-w-none shrink-0"
              />
            ) : (
              <StatIcon label={label} />
            )}
            <span class="min-w-0 truncate" title={label} aria-hidden={toShortLabel(label) !== label ? 'true' : undefined}>
              {toShortLabel(label)}
            </span>
            {toShortLabel(label) !== label && <span class="sr-only">{label}</span>}
          </dt>
          <dd class={clsx('font-semibold', isNested ? 'text-sm' : 'text-base', isAccent && 'text-accent-soft', isHeal && 'text-heal')}>
            {levels ? (
              levels.map(({ level, value: levelValue }, index) => (
                <>
                  {index > 0 && ' '}
                  <span class="mr-1 whitespace-nowrap">
                    <span class="text-[10px] font-normal text-muted">Lv{level}</span> {levelValue}
                  </span>
                </>
              ))
            ) : typeof value === 'string' ? (
              value.split('/').map((part, index) => (
                <>
                  {index > 0 && (
                    <>
                      /<wbr />
                    </>
                  )}
                  {part}
                </>
              ))
            ) : (
              <CostValue value={value} />
            )}
          </dd>
          {batch && (
            <dd class="text-[11px] text-muted">
              {toBatchPrefix(batch.count)}
              <CostValue value={batch.cost} />
            </dd>
          )}
        </div>
      ))}
    </dl>
  )
}
