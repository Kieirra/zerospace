---
import clsx from 'clsx';
import GameImage from '../../game-image/game-image.astro';
import StatTiles from '../stat-tiles/stat-tiles.astro';
import { toWeaponTiles } from '../entity-weapons/entity-weapons.helpers.ts';
import { entityHref } from '../../wiki.helpers.ts';
import type { StatTile, Weapon } from '../../wiki.types.ts';

interface Props {
  name: string;
  linkId?: string;
  subtitle?: string;
  tiles: StatTile[];
  weapons?: Weapon[];
  description?: string;
  stats?: StatTile[];
  isLinkCard?: boolean;
}

const { name, linkId, subtitle, tiles, weapons = [], description, stats = [], isLinkCard } = Astro.props;
const Root = isLinkCard && linkId ? 'a' : 'article';
---

<Root
  href={Root === 'a' && linkId ? entityHref(linkId) : undefined}
  class={clsx('block h-full bevel-sm bg-surface p-3', Root === 'a' && 'hover:bg-surface-hover')}
>
  <h3 class="flex items-center gap-2 font-semibold">
    {
      linkId && (
        <span class="w-8 shrink-0">
          <GameImage id={linkId} name={name} size="thumb" />
        </span>
      )
    }
    {
      Root === 'a' ? (
        <span class="text-accent-soft">{name}</span>
      ) : linkId ? (
        <a href={entityHref(linkId)} class="text-accent-soft underline-offset-2 hover:underline">
          {name}
        </a>
      ) : (
        name
      )
    }
  </h3>
  {subtitle && <p class="text-xs text-muted">{subtitle}</p>}
  {
    tiles.length > 0 && (
      <div class="mt-2">
        <StatTiles tiles={tiles} isNested />
      </div>
    )
  }
  {
    weapons.map((weapon) => (
      <div class="mt-3">
        {weapon.name && <p class="mb-1.5 text-sm font-semibold">{weapon.name}</p>}
        <StatTiles tiles={toWeaponTiles(weapon)} isNested />
      </div>
    ))
  }
  {description && <p class="mt-2 text-sm whitespace-pre-line text-muted">{description}</p>}
  {
    stats.length > 0 && (
      <div class="mt-2">
        <StatTiles tiles={stats} isNested />
      </div>
    )
  }
</Root>
