---
import EntitySection from '../entity-section/entity-section.astro';
import WeaponCard from '../weapon-card/weapon-card.astro';
import type { Weapon } from '../../wiki.types.ts';

interface Props {
  weapons?: Weapon[];
}

const { weapons = [] } = Astro.props;
---

{
  weapons.length > 0 && (
    <EntitySection title="Weapons">
      <ul class="grid gap-2 sm:grid-cols-2">
        {weapons.map((weapon) => (
          <li>
            <WeaponCard weapon={weapon} />
          </li>
        ))}
      </ul>
    </EntitySection>
  )
}
