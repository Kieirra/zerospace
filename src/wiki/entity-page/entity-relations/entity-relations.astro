---
import EntityFacts from '../entity-facts/entity-facts.astro';
import { getEntityMap } from '../../wiki.data.ts';
import { byOrderThenName } from '../../wiki.helpers.ts';
import type { Entity } from '../../wiki.types.ts';

interface Props {
  entity: Entity;
  absorbedBy?: string[];
}

const { producedBy, produces, requires, unlocks, upgradedFrom, transformsInto, mergedFrom, mergesInto } =
  Astro.props.entity;
const entities = await getEntityMap();
const toOrdered = (id: string) => entities.get(id) ?? { name: id };
const toLinks = (ids?: string[]) =>
  ids && [...ids].sort((a, b) => byOrderThenName(toOrdered(a), toOrdered(b))).map((id) => ({ id }));
---

<EntityFacts
  facts={[
    { label: 'Produced by', links: toLinks(producedBy) },
    { label: 'Produces', links: toLinks(produces) },
    { label: 'Requires', links: toLinks(requires) },
    { label: 'Unlocks', links: toLinks(unlocks) },
    { label: 'Upgraded from', links: toLinks(upgradedFrom ? [upgradedFrom] : undefined) },
    { label: 'Transforms into', links: toLinks(transformsInto ? [transformsInto] : undefined) },
    {
      label: 'Merged from',
      links: mergedFrom?.map(({ id, count }) => ({ id, prefix: `${count}×` })),
      hasImages: true,
    },
    { label: 'Merges into', links: toLinks(mergesInto) },
    { label: 'Absorbed by', links: toLinks(Astro.props.absorbedBy) },
  ]}
/>
