---
import DetailCard from '../detail-card/detail-card.astro';
import EntitySection from '../entity-section/entity-section.astro';
import { formatArmor, formatCost, formatOptionalNumber, formatOptionalSeconds, interpolate, keepFilledTiles } from '../../wiki.helpers.ts';
import type { Turret } from '../../wiki.types.ts';

interface Props {
  turrets?: Turret[];
  maxTurrets?: number;
}

const { turrets = [], maxTurrets } = Astro.props;

const toTiles = (turret: Turret) =>
  keepFilledTiles([
    { label: 'Cost', value: formatCost(turret.cost) },
    { label: 'Build time', value: formatOptionalSeconds(turret.buildTime) },
    { label: 'HP', value: formatOptionalNumber(turret.hp) },
    { label: 'Armor type', value: formatArmor(turret) },
  ]);
---

{
  turrets.length > 0 && (
    <EntitySection title="Turrets" subtitle={maxTurrets === undefined ? undefined : `${maxTurrets} slots`}>
      <ul class="grid gap-2 sm:grid-cols-2">
        {turrets.map((turret) => (
          <li>
            <DetailCard
              name={turret.name}
              tiles={toTiles(turret)}
              weapons={turret.weapons}
              description={turret.description && interpolate(turret.description, turret.values)}
            />
          </li>
        ))}
      </ul>
    </EntitySection>
  )
}
