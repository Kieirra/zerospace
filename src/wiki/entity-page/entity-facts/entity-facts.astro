---
import EntityLink from '../../entity-link/entity-link.astro';

interface FactLink {
  id: string;
  suffix?: string;
}

interface Fact {
  label: string;
  text?: string;
  links?: FactLink[];
}

interface Props {
  facts: Fact[];
}

const facts = Astro.props.facts.filter(({ text, links }) => text !== undefined || (links && links.length > 0));
---

{
  facts.length > 0 && (
    <dl class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-4 gap-y-2">
      {facts.map(({ label, text, links = [] }) => (
        <>
          <dt class="text-xs tracking-wide text-muted uppercase">{label}</dt>
          <dd class="tabular-nums">
            {text}
            {links.map(({ id, suffix }, index) => (
              <>
                {index > 0 && ', '}
                <EntityLink id={id} />
                {suffix}
              </>
            ))}
          </dd>
        </>
      ))}
    </dl>
  )
}
