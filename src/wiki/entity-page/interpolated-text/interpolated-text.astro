---
import MismatchMarker from '../../../shared/mismatch-marker/mismatch-marker.astro';
import { formatPatchNoteMismatch, toTextSegments } from '../../wiki.helpers.ts';
import type { PatchNoteMismatch } from '../../wiki-data.types.ts';
import type { DescriptionValues } from '../../wiki.types.ts';

interface Props {
  text: string;
  values?: DescriptionValues;
  // Description variable → value the patch notes announce where the game files differ.
  patchNotes?: Record<string, PatchNoteMismatch>;
}

const { text, values, patchNotes } = Astro.props;
---

{
  toTextSegments(text, values).map(({ text: part, variable }) => {
    const patchNote = variable === undefined ? undefined : patchNotes?.[variable];
    return patchNote ? (
      <>
        {part}
        <MismatchMarker text={formatPatchNoteMismatch(patchNote, part)} />
      </>
    ) : (
      part
    );
  })
}
