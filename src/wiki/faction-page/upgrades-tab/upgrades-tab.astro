---
import EntityRows from '../entity-rows/entity-rows.astro';
import { groupEntities } from '../faction-page.helpers.ts';
import { getEntityMap, getFactionEntities } from '../../wiki.data.ts';
import { byTierThenOrder, formatCost, formatOptionalSeconds, interpolate } from '../../wiki.helpers.ts';
import type { Entity } from '../../wiki.types.ts';

interface Props {
  factionId: string;
}

const { factionId } = Astro.props;
const upgrades = await getFactionEntities(factionId, 'upgrade');
const entities = await getEntityMap();
const groups = groupEntities(upgrades, ({ appliesTo }) => appliesTo?.[0], entities);

const columns = [
  { label: 'Tier', width: '4rem' },
  { label: 'Cost', width: '8.5rem' },
  { label: 'Research time', width: '7rem' },
  { label: 'Requires', width: '9rem' },
  { label: 'Description', isDesktopOnly: true, isWide: true },
];

const toRow = (upgrade: Entity) => ({
  id: upgrade.id,
  name: upgrade.name,
  cells: [
    upgrade.tier,
    formatCost(upgrade.cost),
    formatOptionalSeconds(upgrade.researchTime),
    upgrade.requires?.map((id) => entities.get(id)?.name ?? id).join(', '),
    upgrade.description && interpolate(upgrade.description, upgrade.values),
  ],
});
---

<EntityRows
  columns={columns}
  groups={groups.map(({ title, entities }) => ({ title, rows: entities.sort(byTierThenOrder).map(toRow) }))}
/>
