---
import { Search } from '../search/search.tsx';
import { SITE_NAME } from '../site.constants.ts';
import { toNavSection } from './nav.helpers.ts';

const section = toNavSection(Astro.url.pathname);
const linkClass =
  'text-muted hover:text-text aria-[current=page]:text-text aria-[current=page]:underline aria-[current=page]:decoration-accent-soft aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8';
---

<header class="sticky top-0 z-30 bg-bg/75 backdrop-blur">
  <nav class="relative mx-auto flex h-12 max-w-6xl items-center gap-4 px-4">
    <a href="/wiki" class="font-bold tracking-wide uppercase">{SITE_NAME}</a>
    <a href="/wiki" aria-current={section === 'wiki' ? 'page' : undefined} class={linkClass}>Wiki</a>
    <a href="/guides" aria-current={section === 'guides' ? 'page' : undefined} class={linkClass}>Guides</a>
    <a href="/build-order/" aria-current={section === 'build-order' ? 'page' : undefined} class={linkClass}>Theorycraft</a>
    <div class="ml-auto">
      <Search client:idle />
    </div>
  </nav>
</header>
