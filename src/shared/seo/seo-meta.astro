---
import { SITE_NAME } from '../site.constants.ts';
import { serializeJsonLd, toAbsoluteUrl, toCanonicalPath } from './seo.helpers.ts';
import type { JsonLd } from './seo.helpers.ts';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: JsonLd[];
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  isNoIndex?: boolean;
}

const { title, description, image, jsonLd = [], ogType = 'website', canonicalPath, isNoIndex } = Astro.props;
const canonicalUrl = toAbsoluteUrl(canonicalPath ?? toCanonicalPath(Astro.url.pathname), Astro.site);
const imageUrl = image && toAbsoluteUrl(image, Astro.site);
---

{isNoIndex && <meta name="robots" content="noindex" />}
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="en_US" />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
