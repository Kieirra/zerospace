---
import Tooltip from '../tooltip/tooltip.astro';

interface Props {
  // Patch notes and game files values the shown value stands between.
  text: string;
}

const { text } = Astro.props;
---

<Tooltip
  text={text}
  label={text}
  class="ml-0.5 text-xs font-semibold text-red-400 underline decoration-red-400 decoration-dotted underline-offset-2"
  >?</Tooltip
>
