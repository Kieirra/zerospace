---
import Layout from '../layout/layout.astro';
import { SITE_NAME } from '../site.constants.ts';

interface Props {
  target: string;
}

const { target } = Astro.props;
---

<Layout title={`Redirecting · ${SITE_NAME}`} canonicalPath={target} isNoIndex isCentered>
  <meta slot="head" http-equiv="refresh" content={`0;url=${target}`} />
  <script is:inline define:vars={{ target }}>
    location.replace(target);
  </script>
  <div class="bevel-sm mx-auto max-w-md bg-surface p-6 text-center">
    <p class="label-caps text-muted">Redirecting</p>
    <a href={target} class="mt-3 inline-block text-accent-soft hover:underline">{target}</a>
  </div>
</Layout>
