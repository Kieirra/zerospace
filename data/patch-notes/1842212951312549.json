          "subject": null,
          "entityIds": [],
          "lines": [
            {
              "text": "Heroes now grant XP based on owning player level rather than owning player XP (70 + 0.05 * player XP -> 70 + 70 * player level)"
            },
            {
              "text": "T7 talents changed from flat bonus every time XP gained to bonus based on XP gained",
              "lines": [
                {
                  "text": "Resource Talent +7 hex/flux -> 0.25 hex/flux gained per XP"
                },
                {
                  "text": "Power Talent +1 power -> +0.1 power gained per XP"
                }
              ]
            }
          ]
        }
      ]
    },
