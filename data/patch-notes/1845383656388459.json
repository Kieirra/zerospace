      "entries": [
        {
          "subject": "Mera",
          "entityIds": [
            "grell/hero/mera",
            "protectorate/hero/mera"
          ],
          "lines": [
            {
              "text": "Melee",
              "lines": [
                {
                  "text": "Weapon damage increased from 23 to 24"
                },
                {
                  "text": "Weapon cooldown increased from 1.2s to 1.3s"
                },
                {
                  "text": "Now deals 40% splash damage in 1.5 radius"
                }
              ]
            },
            {
              "text": "Ranged",
              "lines": [
                {
                  "text": "Weapon cooldown reduced from 1.5s to 1.3s"
                },
                {
                  "text": "Now slows targets by 20% for 2 seconds"
                }
              ]
            },
            {
              "text": "Charge",
              "lines": [
                {
                  "text": "Now switches to melee weapon on cast"
                },
                {
                  "text": "No longer grants armor or move speed"
                },
                {
                  "text": "Now restores shield equal to 50% of damage dealth"
                },
                {
                  "text": "Damage changed from 25 to current weapon damage"
                }
              ]
            },
            {
              "text": "Shield ability replaced - now grants nearby allies 20 shields for 5 seconds"
            }
          ]
        }
      ]
    },
