          ]
        },
        {
          "subject": "Judgement",
          "entityIds": [
            "arandi/unit/arandi-judgement"
          ],
          "lines": [
            {
              "text": "Now available from Penumbra without talent"
            },
            {
              "text": "Removed on attack buff"
            },
            {
              "text": "Gained Hallucination spawn aura"
            },
            {
              "text": "Hallucination aura hallucination starting health increased from 25% -> 50%"
            }
          ]
        }
      ]
    },
    {
      "faction": "endari",
      "heading": "Endari",
      "entries": [
        {
          "subject": "Shadow Leech",
          "entityIds": [
            "endari/unit/endari-shadow-leech"
          ],
          "lines": [
            {
              "text": "Spawn count reduced from 4 -> 2"
            },
            {
              "text": "Health increased from 80 -> 120"
            },
            {
              "text": "Duration increased from 8s -> 12s"
            },
            {
              "text": "Slow increased from 25% -> 30%"
            },
            {
              "text": "Now has a maximum of 1 per target"
            },
            {
              "text": "Can now target allies",
              "lines": [
                {
                  "text": "Grants 30% lifesteal and attack speed"
                },
                {
                  "text": "Still deals 8 DPS to friendly units"
                },
                {
                  "text": "Infinite duration until unit dies"
                }
              ]
            }
          ]
        }
      ]
    },
