{
  "id": "1843481262696780",
  "label": "Patch",
  "title": "New Co-op Missions, Revamped AI, Skirmish Updates, Refreshed Economy, & More!",
  "date": "2026-09-12",
  "url": "https://store.steampowered.com/news/app/1605850/view/1843481262696780",
  "sections": [
    {
      "faction": null,
      "heading": "Skirmish Swap Teams",
      "entries": [
        {
          "subject": null,
          "entityIds": [],
          "lines": [
            {
              "text": "You can now drag players in a lobby to change their slot, or their team"
            },
            {
              "text": "Lobby now shows which player will spawn at which location"
            },
            {
              "text": "Fixed Protectorate AI building excessive amounts of striders"
            }
          ],
          "note": "Use the new maps to play a 2v2v2, or show your friends you really are good enough to 1v3 them"
        }
      ]
    },
    {
      "faction": null,
      "heading": "Economy",
      "entries": [
        {
          "subject": null,
          "entityIds": [],
          "lines": [
            {
              "text": "Main base now starts with all Extractors at game start (previously missing 1)"
            },
            {
              "text": "Gold Hexite Pit (All main bases are gold)",
              "lines": [
                {
                  "text": "Bonus income rate reduced from +50% -> +33%"
                },
                {
                  "text": "Max Hexite reduced from 6400 -> 5800"
                }
              ]
            },
            {
              "text": "Max Harvester count reduced by 1 Flux node worth of Harvesters per faction",
              "lines": [
                {
                  "text": "Xol 5 -> 4"
                },
                {
                  "text": "Protectorate/Grell 10 -> 8"
                },
                {
                  "text": "Legion 15 -> 12"
                }
              ]
            }
          ]
        },
        {
          "subject": "Flux Nodes",
          "entityIds": [],
          "lines": [
            {
              "text": "Max Flux reduced from 9999 -> 2000"
            },
            {
              "text": "Now mines at reduced rate (25%) when depleted"
            }
          ]
        }
      ]
    },
    {
      "faction": "the-legion",
      "heading": "Legion",
      "entries": [
        {
          "subject": "Summoning Obelisk",
          "entityIds": [
            "the-legion/talent/summoning-obelisk"
          ],
          "lines": [
            {
              "text": "Summoned Thralls no longer have Reanimate debuff"
            },
            {
              "text": "Summoned unit count decreased from 12 -> 10"
            }
          ]
        },
        {
          "subject": "Inquisitress",
          "entityIds": [
            "the-legion/hero/inquisitress"
          ],
          "lines": [
            {
              "text": "NEW T2 Upgrade: Wake of Fire",
              "lines": [
                {
                  "text": "Charge now leaves behind a trail of fire dealing 50 dps for 5 seconds"
                },
                {
                  "text": "Charge increases armor by 3 for buff duration (3s as with the bonus movespeed)"
                }
              ]
            },
            {
              "text": "One Life For Another",
              "lines": [
                {
                  "text": "Max orbs reduced from 6 -> 3"
                },
                {
                  "text": "Health gain increased from 1x sacrificed Thrall HP -> 2x"
                }
              ]
            }
          ]
        },
        {
          "subject": "Kraegar",
          "entityIds": [
            "the-legion/hero/kraegar"
          ],
          "lines": [
            {
              "text": "Kraegar Killer Instinct upgrade now additionally reduces cooldown from 8s -> 4s"
            }
          ]
        }
      ]
    },
