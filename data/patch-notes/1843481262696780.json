          ],
          "lines": [
            {
              "text": "No longer unlocks/spawns 2 Judgements"
            },
            {
              "text": "Now grants Penumbra an attack which stuns ground units in an area for 1.5 seconds"
            },
            {
              "text": "Now increases Penumbra health by 50%"
            }
          ]
        },
        {
          "subject": "Ethermancer",
          "entityIds": [
            "arandi/unit/arandi-ethermancer"
          ],
          "lines": [
            {
              "text": "Hallucination spawn aura removed (moved to Judgement)"
